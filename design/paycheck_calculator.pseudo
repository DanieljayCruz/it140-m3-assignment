# PUT (output), LET (assignment), IF, ELSE, and ENDIF where they fit your design.

START paycheck_calculator

    OUTPUT "Enter number of hours worked"
    INPUT hours_worked

    IF hours_worked <=40
       LET weekey_pay = hours_worked * 20
    ELSE
        LET overtime_hours = hours_worked - 40
        LET weekly_pay = (40 * 20) + (overtime_hours *30)
    ENDIF

    OUTPUT "Weekly paycheck :$" + weekly_pay

END paycheck_calculator



